# Sao chép file này thành ".env" rồi điền. File .env KHÔNG được đưa lên GitHub.

# --- Facebook (xem docs/FACEBOOK.md) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
# FB_GRAPH_VERSION=v23.0
# FB_POLL_MS=2000

# Chỉ cần khi chạy lên mạng để lấy token: app id/secret + token ngắn hạn
# (dùng cho: npm run fb:token)
# FB_APP_ID=
# FB_APP_SECRET=
# FB_USER_TOKEN=

# Mật khẩu bảo vệ trang web (nên đặt khi chạy trên internet)
# APP_PASSWORD=

# PORT=3000
